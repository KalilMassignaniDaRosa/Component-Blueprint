# Copie para .env e ajuste. O arquivo .env NUNCA vai para o git.

# development | production
APP_ENV=development

# Liga o modo debug do `flask run` (só em desenvolvimento!)
FLASK_DEBUG=1

# Gere uma chave com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave

# Em produção atrás de HTTPS: redireciona HTTP->HTTPS e envia HSTS
FORCE_HTTPS=0
